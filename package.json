    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "agentdock": "link:../agentdock",
    "ink": "^7.1.1",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3"
