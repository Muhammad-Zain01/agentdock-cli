{
  "name": "agentdock-cli",
  "version": "0.1.0",
  "description": "Interactive CLI playground for the AgentDock harness",
  "private": true,
  "type": "module",
  "bin": {
    "agentdock-cli": "./dist/main.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Muhammad-Zain01/agentdock-cli.git"
  },
  "homepage": "https://github.com/Muhammad-Zain01/agentdock-cli#readme",
